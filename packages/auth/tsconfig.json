{
  // Auth and its tests, run by Node.js (Vitest). No Workers types, so a `cloudflare:*` import or a Workers global
  // fails typecheck (the rate limiter is a structural interface); the Node.js types are there for Web Crypto, `Buffer`
  // (the key text), the Vitest config and the shared tools/vitest settings.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src", "test", "vitest.config.ts"]
}
