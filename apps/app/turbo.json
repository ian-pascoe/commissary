{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "description": "Also checks the root files that vitest.config.ts and the tests import",
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/infra/bundle.ts",
        "$TURBO_ROOT$/infra/preview-origin.ts",
        "$TURBO_ROOT$/infra/settings.ts"
      ]
    },
    "test": {
      "description": "The tests import the root's infra files and D1 migrations",
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/infra/bundle.ts",
        "$TURBO_ROOT$/infra/preview-origin.ts",
        "$TURBO_ROOT$/infra/settings.ts",
        "$TURBO_ROOT$/migrations/**"
      ]
    }
  }
}
