{
  "name": "commissary",
  "version": "0.0.0",
  "private": true,
  "description": "Commissary: one service on Cloudflare Workers through which an org reaches models, tools, a browser and hosted agents, under its own credentials, grants and spend limits",
  "type": "module",
  "imports": {
    "#contract/*": "./src/management/contract/*"
  },
  "scripts": {
    "catalog:sync": "node tools/sync-models-dev-catalog.ts",
    "ci:setup": "alchemy deploy --config stacks/github.ts --stage ci --profile admin --adopt && alchemy state read commissary-github/ci/output --profile admin",
    "deploy": "alchemy deploy",
    "deploy:cloud": "alchemy deploy --stage cloud --env-file .env.cloud",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "logs": "alchemy logs",
    "plan": "alchemy plan",
    "prepare": "effect-tsgo patch --no-typescript --oxlint && husky && ([ -n \"$CI\" ] || tools/sync-reference-repos.sh)",
    "repos:sync": "tools/sync-reference-repos.sh",
    "smoke": "sh tools/dev-smoke.sh",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/sso": "1.7.7",
    "@effect/atom-react": "4.0.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@tanstack/react-router": "1.170.44",
    "better-auth": "1.7.7",
    "effect": "4.0.4",
    "fzstd": "^0.1.1",
    "jose": "^6.2.12",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.28.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@distilled.cloud/cloudflare": "1.0.0-rc.15",
    "@effect/platform-node": "4.0.4",
    "@effect/tsgo": "0.52.0",
    "@effect/vitest": "4.0.4",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "alchemy": "2.0.0-beta.83",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "samlify": "2.13.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,mts,cts,js,mjs,cjs}": "oxlint --quiet --no-error-on-unmatched-pattern"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
