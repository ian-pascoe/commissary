{
  // Deploy-time code runs in Node.js, not in workerd: alchemy.run.ts, infra/, stacks/ (Alchemy CLI) and the catalog
  // sync script. The Worker modules they import (apps/app/src/registry/models-dev.ts, secrets/key.ts,
  // management/auth-index-key.ts) are checked here too, with Node.js types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["alchemy.run.ts", "infra", "stacks", "tools/sync-models-dev-catalog.ts"]
}
