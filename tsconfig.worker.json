{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": ".tsbuild/tsconfig.worker.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "test",
    "infra/settings.ts",
    "web/src/lib/account-fields.ts",
    "web/src/lib/accounts.ts",
    "web/src/lib/batch.ts",
    "web/src/lib/catalog.ts",
    "web/src/lib/connect.ts",
    "web/src/lib/failure.ts",
    "web/src/lib/format.ts",
    "web/src/lib/history.ts",
    "web/src/lib/keys.ts",
    "web/src/lib/legacy-hash.ts",
    "web/src/lib/models.ts",
    "web/src/lib/org.ts",
    "web/src/lib/prices.ts",
    "web/src/lib/providers.ts",
    "web/src/lib/quota.ts",
    "web/src/lib/raw-config.ts",
    "web/src/lib/reset-grants.ts",
    "web/src/lib/settings.ts",
    "web/src/lib/theme.ts",
    "web/src/lib/usage.ts",
    "worker-configuration.d.ts",
    "vitest.config.ts"
  ]
}
