# Settings of the hosted stage (docs/DEPLOY.md "Hosted production"): the hosted proxy (ADR 0026) deployed next to the
# self-hosted one. Copy to .env.hosted (git-ignored). `pnpm deploy:hosted` deploys it from this file alone (not .env), and
# `pnpm ci:setup` writes it into the GitHub environment `hosted`, which CI deploys from main.

PROXY_MODE=hosted
# The hosted proxy's own hostname (not the self-hosted one's); its zone must already be in the Cloudflare account.
CF_LLM_PROXY_DOMAIN=llm.example.com
# Platform admins: people who sign in with one of these emails, verified by the provider.
PLATFORM_ADMIN_EMAILS=you@example.com

# At least one sign-in provider (both values of a provider). OAuth callback URLs:
# https://<CF_LLM_PROXY_DOMAIN>/api/auth/callback/github (and /google). A GitHub OAuth app takes one callback host, so
# this one is not the hosted previews' app.
SIGN_IN_GITHUB_CLIENT_ID=
SIGN_IN_GITHUB_CLIENT_SECRET=
# SIGN_IN_GOOGLE_CLIENT_ID=
# SIGN_IN_GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile widget (required) listing CF_LLM_PROXY_DOMAIN among its hostnames.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate-limit namespace: a positive integer unique in the account, so not the previews' (default 7201).
ORG_RATE_LIMIT_NAMESPACE_ID=7201
# ORG_RATE_LIMIT=600
# OWNED_ORG_LIMIT=3
